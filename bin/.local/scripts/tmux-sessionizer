#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # Parent "agent" repos to surface directly. Their sub-repos live nested
    # under repositories/ and must NOT appear as separate sessions, so we list
    # the parent explicitly rather than adding it as a -maxdepth 1 root.
    agent_repos=(~/Trova)
    selected=$( { \
        find ~/Code ~/Personal ~/Projects ~/Worktrees -mindepth 1 -maxdepth 1 -type d 2>/dev/null; \
        printf '%s\n' "${agent_repos[@]}"; \
    } | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

setup_windows() {
    local session=$1
    local dir=$2

    # Window 1 (already created with new-session): editor
    tmux rename-window -t "$session:1" 'editor'

    # Window 2: app / tests
    tmux new-window -t "$session:2" -n 'app' -c "$dir"

    # Window 3: git
    tmux new-window -t "$session:3" -n 'git' -c "$dir"
    tmux send-keys -t "$session:3" 'lazygit' Enter

    # Focus back on editor window
    tmux select-window -t "$session:1"
}

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    setup_windows "$selected_name" "$selected"
    exit 0
fi

if ! tmux has-session -t="$selected_name" 2> /dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
    setup_windows "$selected_name" "$selected"
fi

tmux switch-client -t "$selected_name"
